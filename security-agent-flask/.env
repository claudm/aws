# Fonte de Spaces/Pentests/Endpoints:
#   securityagent -> API real AWS Security Agent (boto3)
#   memory        -> dados de exemplo (dev/local, sem AWS)
SA_BACKEND=securityagent

# Persistência do modo memory/dynamodb (só usado quando SA_BACKEND=memory):
STORE_BACKEND=memory

AWS_REGION=sa-east-1
# EXPECTED_ACCOUNT_ID=000000000000
EXPECTED_ACCOUNT_ID=000000000000
# ASSUME_ROLE_ARN=arn:aws:iam::000000000000:role/role-security-agent-pentest

DDB_SPACES_TABLE=security-agent-spaces
DDB_PENTESTS_TABLE=security-agent-pentests

S3_ARTIFACTS_BUCKET=uploads-uva-dev
S3_ARTIFACTS_PREFIX=security-agent-artifacts

# Tags do Agent Space usam TagResource/ListTagsForResource, que exigem o ARN
# do space — e nenhuma operacao do servico devolve esse ARN. O padrao abaixo
# segue a convencao da AWS; descomente e ajuste se a sua conta usar outro.
# AGENT_SPACE_ARN_TEMPLATE=arn:aws:securityagent:{region}:{account_id}:agent-space/{space_id}

SECRETS_PREFIX=security-agent/pentests
ROLE_NAME_FILTER=security-agent

# O front é servido pelo próprio Flask (mesma origem), então CORS é opcional.
# Preencha só se for hospedar o front em outra origem.
CORS_ORIGINS=

FLASK_SECRET_KEY=change-me
