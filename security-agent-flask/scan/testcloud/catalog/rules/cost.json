          },
          {
            "operation": "describe_db_instances",
            "extract": "DBInstances.0.DBInstanceClass",
            "transform": "family_map",
            "map": {
              "m1": {
                "family": "m6i",
                "min_size": "large",
                "size_map": {
                  "10xlarge": "12xlarge"
                }
              },
              "m2": {
                "family": "r6i",
                "min_size": "large"
              },
              "m3": {
                "family": "m6i",
                "min_size": "large",
                "size_map": {
                  "10xlarge": "12xlarge"
                }
              },
              "m4": {
                "family": "m6i",
                "min_size": "large",
                "size_map": {
                  "10xlarge": "12xlarge"
                }
              },
              "r3": {
                "family": "r6i",
                "min_size": "large"
              },
              "r4": {
                "family": "r6i",
                "min_size": "large"
              },
              "t1": "t3",
              "t2": "t3"
            }
          },
          {
            "operation": "describe_db_instances",
            "extract": "DBInstances.0.Engine"
          },
          {
            "operation": "describe_db_instances",
