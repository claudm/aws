    ],
    "evaluate": {
      "resource": "ec2.volume",
      "service": "ec2",
      "skip_if_none": true,
      "operator": "and",
      "conditions": [
        {
          "operation": "describe_volumes",
          "extract": "Volumes.0.State",
          "operator": "equals",
          "value": "in-use"
        },
        {
          "operation": "get_metric_data",
          "service": "cloudwatch",
          "batch": true,
          "params": {
            "MetricDataQueries": [
              {
                "Id": "r",
                "ReturnData": false,
                "MetricStat": {
                  "Metric": {
                    "Namespace": "AWS/EBS",
                    "MetricName": "VolumeReadOps",
                    "Dimensions": [
                      {
                        "Name": "VolumeId",
                        "Value": "{VolumeIds.0}"
                      }
                    ]
                  },
                  "Period": 86400,
                  "Stat": "Sum"
                }
              },
              {
                "Id": "w",
                "ReturnData": false,
                "MetricStat": {
                  "Metric": {
                    "Namespace": "AWS/EBS",
                    "MetricName": "VolumeWriteOps",
                    "Dimensions": [
                      {
                        "Name": "VolumeId",
                        "Value": "{VolumeIds.0}"
                      }
                    ]
                  },
                  "Period": 86400,
                  "Stat": "Sum"
                }
              },
              {
                "Id": "result",
                "Expression": "r+w",
                "ReturnData": true
              }
            ],
            "StartTime": "{now-14d}",
            "EndTime": "{now}"
          },
          "operator": "aggregate",
          "extract": "MetricDataResults.0.Values",
          "fn": "max",
          "compare": "lt",
          "value": 100,
          "min_count": 7
        }
      ],
      "vars": [
        {
          "operation": "describe_volumes",
          "extract": "Volumes.0.Attachments.0.InstanceId"
        }
      ],
      "waste": {
        "fn": "ebs_monthly",
        "args": [
          {
            "operation": "describe_volumes",
            "extract": "Volumes.0.VolumeType",
            "default": "gp2"
          },
          {
            "operation": "describe_volumes",
            "extract": "Volumes.0.Size",
            "default": 0
          },
          {
            "operation": "describe_volumes",
            "extract": "Volumes.0.Iops",
            "default": 0
          },
          {
            "operation": "describe_volumes",
            "extract": "Volumes.0.Throughput",
            "default": 0
          }
        ]
      },
      "overrides": [
        {
          "when": {
            "capture": "waste",
            "extract": "value",
            "operator": "gte",
            "value": 50
          },
          "severity": "medium"
        }
      ]
    }
  },
  "COST.ORPHAN_SNAPSHOTS": {
    "title": "Snapshot {var} de um volume que não existe mais ({var} GiB)",
    "severity": "low",
    "description": "O volume de origem foi apagado e o snapshot não é usado por nenhuma AMI da conta. Snapshots órfãos costumam ser backups esquecidos de recursos já descomissionados.",
    "remediation": "Confirme a política de retenção; se não houver obrigação de guarda, delete o snapshot (ou mova para o tier Archive, 75% mais barato).",
    "pillar": "cost",
    "well_architected": "COST04-BP03",
    "exposure": [
      "empty_resource"
    ],
    "permissions": [
      "ec2:DescribeSnapshots",
      "ec2:DescribeVolumes",
      "ec2:DescribeImages"
    ],
    "evaluate": {
      "resource": "ec2.snapshot",
      "service": "ec2",
      "skip_if_none": true,
      "operator": "and",
      "conditions": [
        {
          "operation": "describe_snapshots",
          "params": {
            "SnapshotIds": [
              "{SnapshotId}"
            ]
          },
          "extract": "Snapshots",
          "operator": "any_item",
          "where": {
            "operation": "describe_volumes",
            "extract": "Volumes",
            "operator": "len_lt",
            "value": 1,
            "params": {
              "VolumeIds": [
                "{item.VolumeId}"
              ]
            },
            "ignore_errors": [
              "InvalidVolume.NotFound"
            ],
            "skip_if_none": false
          }
        },
        {
          "operation": "describe_images",
          "extract": "Images",
          "operator": "len_lt",
          "value": 1,
          "params": {
            "Owners": [
              "self"
            ],
            "Filters": [
              {
                "Name": "block-device-mapping.snapshot-id",
                "Values": [
                  "{SnapshotId}"
                ]
              }
            ]
          }
        }
      ],
      "vars": [
        {
          "operation": "describe_snapshots",
          "params": {
            "SnapshotIds": [
              "{SnapshotId}"
            ]
          },
          "extract": "Snapshots.0.VolumeSize"
        }
      ],
      "waste": {
        "fn": "snapshot_monthly",
        "args": [
          {
            "operation": "describe_snapshots",
            "params": {
              "SnapshotIds": [
                "{SnapshotId}"
              ]
            },
            "extract": "Snapshots.0.VolumeSize",
            "default": 0
          }
        ]
      }
    }
  },
  "COST.RDS_PIOPS_UNDERUSED": {
    "title": "RDS '{var}' com {var} IOPS provisionados ({var}) e pico de {var} IOPS",
    "severity": "low",
    "description": "O pico de ReadIOPS + WriteIOPS (média horária) dos últimos 14 dias ficou abaixo do baseline do gp3. IOPS provisionado em io1/io2 é cobrado por IOPS/mês.",
    "remediation": "Migre o storage para gp3 (modify-db-instance --storage-type gp3). A conversão é online, com possível queda de performance durante a otimização do storage.",
    "pillar": "cost",
    "well_architected": "COST06-BP03",
    "exposure": [
      "data_store"
    ],
    "permissions": [
      "rds:DescribeDBInstances",
      "cloudwatch:GetMetricData"
    ],
    "evaluate": {
      "resource": "rds.instance",
      "service": "rds",
      "skip_if_none": true,
      "operator": "and",
      "conditions": [
        {
          "operation": "describe_db_instances",
          "extract": "DBInstances.0.StorageType",
          "operator": "in",
          "value": [
            "io1",
            "io2"
          ]
        },
        {
          "operation": "get_metric_data",
          "service": "cloudwatch",
          "batch": true,
          "params": {
            "MetricDataQueries": [
              {
                "Id": "r",
                "ReturnData": false,
                "MetricStat": {
                  "Metric": {
                    "Namespace": "AWS/RDS",
                    "MetricName": "ReadIOPS",
                    "Dimensions": [
                      {
                        "Name": "DBInstanceIdentifier",
                        "Value": "{DBInstanceIdentifier}"
                      }
                    ]
                  },
                  "Period": 3600,
                  "Stat": "Average"
                }
              },
              {
                "Id": "w",
                "ReturnData": false,
                "MetricStat": {
                  "Metric": {
                    "Namespace": "AWS/RDS",
                    "MetricName": "WriteIOPS",
                    "Dimensions": [
                      {
                        "Name": "DBInstanceIdentifier",
                        "Value": "{DBInstanceIdentifier}"
                      }
                    ]
                  },
                  "Period": 3600,
                  "Stat": "Average"
                }
              },
              {
                "Id": "result",
                "Expression": "r+w",
                "ReturnData": true
              }
            ],
            "StartTime": "{now-14d}",
            "EndTime": "{now}"
          },
          "operator": "aggregate",
          "extract": "MetricDataResults.0.Values",
          "fn": "max",
          "compare": "lt",
          "value": 3000,
          "min_count": 24,
          "id": "peak"
        }
      ],
      "vars": [
        {
          "operation": "describe_db_instances",
          "extract": "DBInstances.0.Iops"
        },
        {
          "operation": "describe_db_instances",
          "extract": "DBInstances.0.StorageType"
        },
        {
          "capture": "peak",
          "transform": "round",
          "digits": 0
        }
      ],
      "waste": {
        "fn": "rds_piops_saving",
        "args": [
          {
            "operation": "describe_db_instances",
            "extract": "DBInstances.0.AllocatedStorage",
            "default": 0
          },
          {
            "operation": "describe_db_instances",
            "extract": "DBInstances.0.Iops",
            "default": 0
          }
        ]
      },
      "overrides": [
        {
          "when": {
            "capture": "waste",
            "extract": "value",
            "operator": "gte",
            "value": 100
          },
          "severity": "medium"
        }
      ]
    }
  },
  "COST.RDS_PREVIOUS_GENERATION": {
