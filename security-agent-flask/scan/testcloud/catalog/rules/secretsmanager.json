{
  "SECRETSMANAGER.NO_ROTATION": {
    "title": "Secret '{var}' sem rotação automática",
    "severity": "low",
    "description": "Rotação desabilitada e último valor alterado há mais de 90 dias.",
    "remediation": "Configure rotação com Lambda (para RDS existem templates prontos) ou documente o processo manual.",
    "pillar": "security",
    "well_architected": "SEC02-BP05",
    "permissions": [
      "secretsmanager:ListSecrets",
      "secretsmanager:DescribeSecret"
    ],
    "evaluate": {
      "resource": "secretsmanager.secret",
      "service": "secretsmanager",
      "skip_if_none": true,
      "operator": "and",
      "conditions": [
        {
          "operation": "describe_secret",
          "extract": "RotationEnabled",
          "operator": "falsy"
        },
        {
          "operation": "describe_secret",
          "extract": "LastChangedDate",
          "operator": "age_days_gt",
          "value": 90
        }
      ],
      "exposure": [],
      "overrides": [
        {
          "when": {
            "operation": "describe_secret",
            "extract": "LastChangedDate",
            "operator": "falsy"
          },
          "description": "Rotação desabilitada."
        }
      ]
    }
  }
}
